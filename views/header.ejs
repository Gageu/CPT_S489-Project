<%
  let _path = '';
  if (typeof currentPath !== 'undefined') {
    _path = currentPath;
  }
%>

<% const isPublicPage = _path === '/' || _path === '/login' || _path === '/signup'; %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Study Group Organizer</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
  <header class="bg-primary text-white text-center py-3">
    <h1>Study Group Organizer</h1>
    <% if (isPublicPage) { %>
      <nav class="nav justify-content-center">
        <% if (_path !== '/login') { %>
          <a class="nav-link text-white" href="/login">Login</a>
        <% } %>
        <% if (_path !== '/signup') { %>
          <a class="nav-link text-white" href="/signup">Sign Up</a>
        <% } %>
      </nav>
      <% } else if (user) { %>
        <nav class="nav justify-content-center">
          <% if (user.role === 'admin') { %>
            <% if (_path !== '/admin-manage-users') { %>
              <a class="nav-link text-white" href="/admin-manage-users">Admin Panel</a>
            <% } %>
            <a class="nav-link text-white" href="/logout">Logout</a>
          <% } else { %>
            <% if (_path !== '/dashboard') { %>
              <a class="nav-link text-white" href="/dashboard">Dashboard</a>
            <% } %>
            <% if (_path !== '/create-group') { %>
              <a class="nav-link text-white" href="/create-group">Create Group</a>
            <% } %>
            <% if (_path !== '/notifications') { %>
              <a class="nav-link text-white" href="/notifications">Notifications</a>
            <% } %>
            <% if (_path !== '/profile') { %>
              <a class="nav-link text-white" href="/profile">Profile</a>
            <% } %>
            <a class="nav-link text-white" href="/logout">Logout</a>
          <% } %>
        </nav>
      <% } %>          
  </header>
