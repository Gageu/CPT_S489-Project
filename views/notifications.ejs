
<%- include('header') %>

<header class="bg-dark text-white text-center py-3">
    <h1>Notifications</h1>
</header>

<main class="container my-5">
    <h2>Pending Group Invites</h2>
    
    <% if (invites.length === 0) { %>
      <h4 class="text-muted">No new notifications</h4>
    <% } else { %>
      <ul class="list-group mb-4">
        <% invites.forEach(invite => { %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            Group ID: <%= invite.group_id %>
            <div>
              <form method="POST" action="/notifications" class="d-inline">
                <input type="hidden" name="id" value="<%= invite.id %>">
                <button type="submit" name="action" value="accept" class="btn btn-success btn-sm">Accept</button>
              </form>
              <form method="POST" action="/notifications" class="d-inline">
                <input type="hidden" name="id" value="<%= invite.id %>">
                <button type="submit" name="action" value="decline" class="btn btn-danger btn-sm">Decline</button>
              </form>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>

</main>

<%- include('footer') %>