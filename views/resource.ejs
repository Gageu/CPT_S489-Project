<%- include('header') %>

<header class="bg-dark text-white text-center py-3">
    <h1>Resources</h1>
</header>
<main class="container my-5">
    <h2>Upload and Download Resources</h2>
    <% if (canUpload) { %>
      <div id="professor-section" class="mb-4">
        <h4>Upload Resource (Professors Only)</h4>
        <form method="POST" action="/resource">
          <div class="mb-3">
            <label for="title" class="form-label">Resource Title</label>
            <input type="text" class="form-control" id="title" name="title" required>
          </div>
          <div class="mb-3">
            <label for="url" class="form-label">Resource URL</label>
            <input type="url" class="form-control" id="url" name="url" required>
          </div>
          <button type="submit" class="btn btn-success">Upload</button>
        </form>
      </div>
    <% } %>

    <h4>Available Resources</h4>
    
    <% if (resources.length === 0) { %>
      <p>No resources available yet.</p>
    <% } else { %>
      <ul class="list-group">
        <% resources.forEach(resource => { %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <a href="<%= resource.url %>" target="_blank"><%= resource.title %></a>
            <a href="<%= resource.url %>" class="btn btn-primary btn-sm" download>Download</a>
          </li>
        <% }) %>
      </ul>
    <% } %>

</main>

<%- include('footer') %>